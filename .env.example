# --- Runtime ---
NODE_ENV=development
# Prod: https://qualifyourlead.com
APP_BASE_URL=http://localhost:3000
# Secret de session/signatures internes (openssl rand -hex 32)
SESSION_SECRET=change-me-32-bytes-hex

# --- Données ---
DATABASE_URL=postgresql://decroche:***@postgres:5432/decroche
REDIS_URL=redis://redis:6379

# --- LLM (DeepSeek) ---
# deepseek-chat est déprécié depuis le 24/07/2026 : ne jamais l'utiliser.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Version de prompt active (dossier prompts/qualifier/<version>.system.md)
PROMPT_QUALIFIER_VERSION=v1

# --- Messagerie SMS (fake | smsmode | twilio) ---
MESSAGING_PROVIDER=fake
SMSMODE_API_KEY=
# Voix (réception du renvoi *61*) : Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# --- Paiement Stripe (docs/testing-strategy.md + src/lib/pricing.ts) ---
# Clés à créer/récupérer dans le dashboard Stripe. JAMAIS de clé live dans le
# repo ni dans un chat — uniquement dans ce fichier .env sur le VPS.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs des abonnements (dashboard Stripe → Produits → prix récurrent mensuel)
STRIPE_PRICE_PRO=
STRIPE_PRICE_ARTISAN=

# --- Dashboard humain (protection basique MVP pilotes — cf docs/tech-debt.md #5) ---
DASHBOARD_USER=admin
DASHBOARD_PASS=change-me

# --- Interface agent Cowork/Hermes (docs/automation.md) ---
# Token unique, longueur type openssl rand -hex 32. Jamais exposé au navigateur
# (seul /ops, protégé par Basic Auth ci-dessus, appelle la logique en interne).
OPS_API_TOKEN=

# --- Prospection (scripts/leadgen — hors app produit, "npm run leads:generate") ---
# Collecte (Apify) + enrichissement (réutilise DEEPSEEK_API_KEY ci-dessus, pas de clé séparée)
APIFY_API_TOKEN=
APIFY_ACTOR_ID=compass~crawler-google-places
LEADGEN_MAX_LEADS=100
LEADGEN_MAX_PER_QUERY=40
LEADGEN_OUTPUT_DIR=research/leads
# Optionnel, non utilisé par défaut — réservé à une future collecte Google
# Maps/Places assistée par Gemini (l'enrichissement tourne sur DeepSeek).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
