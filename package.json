{
  "name": "decroche",
  "version": "0.1.0",
  "private": true,
  "description": "Agent IA de qualification des appels manqués pour artisans BTP",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx --env-file-if-exists=.env src/worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir tests/unit",
    "test:int": "vitest run --dir tests/integration",
    "test:all": "vitest run",
    "test:e2e": "playwright test",
    "test:prompts": "tsx --env-file-if-exists=.env prompts/regression/run.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "account:create": "tsx --env-file-if-exists=.env scripts/create-account.ts",
    "leads:generate": "tsx --env-file-if-exists=.env scripts/leadgen/run.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.10.0",
    "bullmq": "^5.44.0",
    "ioredis": "^5.10.1",
    "next": "^15.3.0",
    "pino": "^9.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "stripe": "^22.3.1",
    "tsx": "^4.19.0",
    "yaml": "^2.7.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "prisma": "^6.10.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
